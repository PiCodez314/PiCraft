{
    "format_version": "1.21.90",
    "minecraft:entity": {
        "description": {
            "identifier": "picraft:dragon",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "picraft:tamed": {
                "minecraft:is_tamed": {},
                "minecraft:behavior.follow_owner": {
                    "priority": 4,
                    "speed_multiplier": 1.0,
                    "start_distance": 8,
                    "stop_distance": 3
                },
                "minecraft:behavior.owner_hurt_by_target": {
                    "priority": 1
                },
                "minecraft:behavior.owner_hurt_target": {
                    "priority": 2
                }
            },
            "picraft:sitting": {
                "minecraft:sittable": {}
            },
            "picraft:wandering": {
                "minecraft:behavior.random_fly": {
                    "priority": 6,
                    "speed_multiplier": 1.0,
                    "xz_dist": 10,
                    "y_dist": 7
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": ["dragon", "mob"]
            },
            "minecraft:health": {
                "value": 60,
                "max": 60
            },
            "minecraft:movement": {
                "value": 0.05
            },
            "minecraft:movement.fly": {},
            "minecraft:navigation.fly": {
                "can_path_over_water": true,
                "avoid_water": false
            },
            "minecraft:flying_speed": {
                "value": 0.05
            },
            "minecraft:physics": {
                "has_gravity": false
            },
            "minecraft:collision_box": {
                "width": 1.5,
                "height": 2.0
            },
            "minecraft:tameable": {
                "probability": 1.0,
                "tame_items": "picraft:dragon_egg",
                "tame_event": {
                    "event": "picraft:on_tame",
                    "target": "self"
                }
            },
            "minecraft:rideable": {
                "seat_count": 1,
                "family_types": ["player"],
                "seats": {
                    "position": [0, 1.6, -0.2]
                },
                "pull_in_entities": false,
                "on_rider_enter_event": "picraft:on_rider_enter",
                "on_rider_exit_event": "picraft:on_rider_exit"
            },
            "minecraft:free_camera_controlled": {
                "strafe_speed_modifier": 1,
                "backwards_movement_modifier": 0.5
            },
            "minecraft:vertical_movement_action": {
                "vertical_velocity": 0.5
            },
            "minecraft:can_fly": {},
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.stay_while_sitting": {
                "priority": 3
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 8.0
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": ["picraft:wandering"]
                }
            },
            "picraft:on_tame": {
                "add": {
                    "component_groups": ["picraft:tamed"]
                }
            },
            "picraft:on_rider_enter": {
                "remove": {
                    "component_groups": ["picraft:wandering"]
                }
            },
            "picraft:on_rider_exit": {
                "add": {
                    "component_groups": ["picraft:wandering"]
                }
            }
        }
    }
}
